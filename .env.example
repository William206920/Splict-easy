# Server-only values. Never use a PUBLIC_/VITE_/NEXT_PUBLIC_ prefix for secrets.
MOONBIT_BASE_URL=https://api.deepseek.com
MOONBIT_MODEL=deepseek-flash
MOONBIT_API_KEY=

# Persistent, atomic quota storage. Set via Vercel Marketplace > Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SPLITEASY_ACCESS_MODE=public
SPLITEASY_HOURLY_LIMIT=10
SPLITEASY_DAILY_LIMIT=100

# Optional invite mode only; unused in public mode.
# SPLITEASY_ACCESS_MODE=invite
# SPLITEASY_ACCESS_CODE=at-least-16-random-characters
