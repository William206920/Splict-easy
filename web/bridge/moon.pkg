import {
  "spliteasy/desktop/shared",
  "spliteasy/desktop/ai",
  "moonbitlang/core/json",
}

supported_targets = "js"

options(
  link: {
    "js": {
      "exports": [
        "execute",
        "model_request",
        "model_response",
        "browser_start",
        "gateway_config",
        "gateway_input",
        "gateway_request",
        "gateway_response",
        "hosting_config",
        "gateway_http_policy",
      ],
      "format": "esm",
    },
  },
)
